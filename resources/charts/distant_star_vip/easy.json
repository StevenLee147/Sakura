  "lyrics": [
    {
      "time": 18900,
      "end_time": 23700,
      "text": "跨越亿万光年的微光，在夜樱枝头轻轻停驻",
      "sub_text": "Starlight from light-years away rests upon night sakura boughs"
    },
    {
      "time": 42525,
      "end_time": 47325,
      "text": "每一次遥远的回响，都是宿命重逢的序章",
      "sub_text": "Every distant echo writes the prelude of our reunion"
    },
    {
      "time": 66150,
      "end_time": 70950,
      "text": "循着银月铺展的轨迹，伸手触碰星海彼岸",
      "sub_text": "Follow the silver-moon trail to touch the far shore of stars"
    },
    {
      "time": 89775,
      "end_time": 94575,
      "text": "当黎明染亮天际线，星辉仍守护着誓言",
      "sub_text": "As dawn gilds the horizon, starlight still guards our vow"
    }
  ]
