  "lyrics": [
    {
      "time": 24819,
      "end_time": 29619,
      "text": "刹那芳华凝于指尖，镜湖微澜倒映月弦",
      "sub_text": "A fleeting bloom rests on fingertips over the mirrored lake"
    },
    {
      "time": 55843,
      "end_time": 60643,
      "text": "里章琴音悄然苏醒，唤醒沉睡百年的花影",
      "sub_text": "The inner movement awakens hundred-year slumbering petals"
    },
    {
      "time": 86867,
      "end_time": 91667,
      "text": "一瞬满开即为永恒，与月光同频呼吸",
      "sub_text": "One instant in full bloom becomes eternity in moonlight"
    },
    {
      "time": 117891,
      "end_time": 122691,
      "text": "落樱归于琉璃幻梦，余音仍在星河回荡",
      "sub_text": "Falling blossoms return to glass dreams across the stars"
    }
  ]
